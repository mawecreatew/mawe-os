{
  "name": "mawe-os",
  "version": "0.2.0",
  "private": true,
  "description": "Mawe OS — escritório digital privado da Mawe Create (protótipo local).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.50.0",
    "typescript": ">=5.8.0"
  }
}
